# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv/
env/
venv/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and scratch
*.log
scratch/
.system_generated/

# Uploaded and temporary pipeline data
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/cleaned/*
!backend/data/cleaned/.gitkeep
backend/artifacts/candidates/*
!backend/artifacts/candidates/.gitkeep

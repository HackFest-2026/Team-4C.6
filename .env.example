# ===================================================================
# CostPilot AI — Root Environment Configuration Template
# Place actual secrets in .env (never commit real production API keys)
# ===================================================================

ENVIRONMENT=development
SECRET_KEY=costpilot-super-secret-development-key-change-in-production

# AI Provider Configuration
# Options: offline | gemini
AI_PROVIDER=offline

# Primary AI Provider API Key (e.g. your Gemini API key)
AI_API_KEY=

# Fallback Gemini API Key (checked if AI_API_KEY is empty)
GEMINI_API_KEY=

# Gemini Model Name (supported default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini Request Timeout in Seconds
GEMINI_TIMEOUT_SECONDS=30.0

# Gemini Max Retries for Transient Errors
GEMINI_MAX_RETRIES=2

# Atlassian Jira Cloud Integration
# Format: https://your-domain.atlassian.net
JIRA_BASE_URL=
# Atlassian account email
JIRA_EMAIL=
# Atlassian Jira API token (generate from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=
# Default Jira project key (e.g. PROJ, COST)
JIRA_PROJECT_KEY=
# Jira request timeout in seconds
JIRA_TIMEOUT_SECONDS=25.0

# Database Configuration
DATABASE_URL=sqlite:///backend/app/db/costpilot.db

# Default Estimation Parameters
DEFAULT_CURRENCY=INR
DEFAULT_CONTINGENCY_PCT=0.15
WORKING_HOURS_PER_DAY=8.0
PRODUCTIVE_HOURS_PER_DAY=6.0
DEFAULT_AVAILABILITY_FACTOR=0.85
